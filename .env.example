# Nothing here is required. The server generates its auth secret on first
# start and keeps it next to the database; the setup
# wizard collects the instance URL, GitHub App, and connectors. Docker compose
# reads this file for ${VAR} substitution in docker-compose*.yml; the
# single-binary server and a host-run runner read the same names from the
# process environment.

# --- Server: optional -----------------------------------------------------
# Pin the secret that signs sessions and encrypts stored secrets instead of
# using the generated <db dir>/auth-secret. Changing it later orphans every
# stored secret.
#NEXUL_AUTH_SECRET=
# Origin the OAuth callback redirects the browser to after login. Only for a
# split-origin dev setup (Vite on :5173); otherwise the instance URL is used.
#NEXUL_SPA_ORIGIN=
# Local dev only: GET /auth/dev-login mints a session with no GitHub round trip.
# NEVER true in production (.scratch/pre-release/issues/07-verify-dev-login-disabled.md).
#NEXUL_DEV_LOGIN=true
# Single-binary only; compose sets these itself.
#NEXUL_DB_PATH=./data/nexul.db
#NEXUL_HTTP_ADDR=:8080
#NEXUL_LOG_LEVEL=info
# OTLP/HTTP log shipping (base URL, /v1/logs is appended); empty keeps logs on stderr only.
#NEXUL_OTLP_ENDPOINT=http://localhost:5080/api/default
#NEXUL_OTLP_USER=
#NEXUL_OTLP_TOKEN=

# --- Logs: OpenObserve (compose only) -------------------------------------
# UI and MCP sign-in at http://<host>:5080; the token only authenticates ingest.
NEXUL_LOGS_EMAIL=nexul@nexul.local
NEXUL_LOGS_PASSWORD=DevLogs-rotate-me-1
NEXUL_LOGS_TOKEN=dev-logs-token-rotate-me

# --- Instance runner (compose only) ---------------------------------------
# Host path stacks are checked out to. Same path inside and outside the
# container: the host's docker daemon resolves compose bind mounts from it.
NEXUL_STACK_ROOT=/data/nexul
# Optional fallback for private clones; builds normally receive the GitHub
# connector's token from the server per job.
NEXUL_GIT_TOKEN=

# --- Runner and automations host (installed by nexul, not compose) --------
# `nexul install runner|automations` writes these into each unit's env file
# after trading the Add dialog's one-time code for the host's own credential.
#NEXUL_SERVER_URL=https://deploy.example.com
#NEXUL_CREDENTIAL_FILE=/opt/nexul/runner-<name>/credential
#NEXUL_RUNNER_NAME=                 # or NEXUL_AUTOMATIONS_HOST_NAME for an automations host
#NEXUL_CTL=/usr/local/bin/nexul
#NEXUL_STACK_ROOT=
#NEXUL_GIT_TOKEN=
# Dev stacks only: with no credential file yet, enroll with the code in this file.
#NEXUL_ENROLL_CODE_FILE=
#NEXUL_LOG_LEVEL=info
#NEXUL_RUNNER_HEARTBEAT=10s
#NEXUL_RUNNER_CONNECT_TIMEOUT=10s
#NEXUL_RUNNER_BACKOFF_BASE=1s
#NEXUL_RUNNER_BACKOFF_MAX=30s
