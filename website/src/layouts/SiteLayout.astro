---
import '../styles/landing.css';
import '../styles/tokens.css';
import '../styles/site-header.css';
import SiteHead from '../components/SiteHead.astro';
import { NexulIcon } from '../components/NexulIcon';
import { SiteHeader, github } from '../components/SiteHeader';

interface Props {
	title: string;
	description: string;
	ogDescription?: string;
}

const { title, description, ogDescription = description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<SiteHead />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader pathname={Astro.url.pathname} />

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap"><div class="footer-top"><a class="wordmark" href="/" aria-label="Nexul home"><NexulIcon /> Nexul</a><p>One loop from docs to deploy.</p><nav aria-label="Footer navigation"><a href="/docs/">Documentation</a><a href="/roadmap/">Roadmap</a><a href="/changelog/">Changelog</a><a href={github}>GitHub <span aria-hidden="true">↗</span></a><a href="/docs/contributing/licensing/">License</a></nav></div><div class="footer-bottom"><span>Your work. Your servers.</span><p>AGPL-3.0 core. Commercial features live in <code>ee/</code>. <a href="/docs/contributing/licensing/">How licensing works <span aria-hidden="true">↗</span></a></p></div></div>
		</footer>
	</body>
</html>
