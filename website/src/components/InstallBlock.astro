---
import InstallCommand from './InstallCommand.astro';
---

<div class="install-block">
	<InstallCommand command="curl -fsSL https://nexul.io/install.sh | sh" platform="Linux server" />
	<div class="install-meta"><span>Linux · sets up Docker</span><a href="/docs/guide/install/">Installation guide <span aria-hidden="true">↗</span></a></div>
</div>

<style>
	.install-meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--page-muted); font-size: 11px; }
	.install-meta a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
	@media (hover: hover) and (pointer: fine) {
		.install-meta a:hover { color: var(--page-fg); }
	}
</style>
