---
interface Props {
	command: string;
	platform: string;
}
const { command, platform } = Astro.props;
---

<div class="cmd">
	<pre tabindex="0" role="region" aria-label={`${platform} installation command`}><code>{command}</code></pre>
	<button type="button" data-copy-command aria-label="Copy install command" title="Copy command" disabled>
		<svg class="icon-copy" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
			<rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
			<path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2" />
		</svg>
		<svg class="icon-done" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
			<path d="M3 8.5l3 3 7-7" />
		</svg>
	</button>
	<span class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
</div>

<style>
	.cmd {
		position: relative;
		display: flex;
		align-items: center;
		gap: 4px;
		min-width: 0;
		padding: 4px 4px 4px 14px;
		border-radius: var(--shape-lg);
		background: var(--card);
		box-shadow: inset 0 1px 0 0 var(--panel-highlight), 0 0 0 1px var(--panel-ring), var(--shadow-card);
	}
	/* One line always; a command wider than its box scrolls, with its cut edge faded until the end is reached. */
	pre {
		flex: 1;
		min-width: 0;
		margin: 0;
		padding-block: 10px;
		overflow-x: auto;
		scrollbar-width: none;
		font: 12px/24px var(--font-mono-stack);
		white-space: pre;
	}
	pre::-webkit-scrollbar { display: none; }
	pre[data-overflow]:not([data-at-end]) { mask-image: linear-gradient(to left, transparent, #000 32px); }
	pre:focus-visible { outline: none; }
	.cmd:has(pre:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
	button {
		position: relative;
		display: grid;
		place-items: center;
		flex: 0 0 40px;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: var(--shape-md);
		background: var(--brand);
		color: var(--brand-foreground);
		cursor: pointer;
		touch-action: manipulation;
		transition: background-color 120ms var(--ease-standard);
	}
	button::after { content: ''; position: absolute; inset: -2px; }
	button:disabled { opacity: .4; cursor: default; }
	@media (hover: hover) and (pointer: fine) {
		button:not(:disabled):hover { background: color-mix(in oklab, var(--brand) 88%, var(--foreground)); }
	}
	button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
	button svg { grid-area: 1 / 1; transition: opacity 150ms var(--ease-out), transform 150ms var(--ease-out), filter 150ms var(--ease-out); }
	.icon-done { opacity: 0; transform: scale(0.6); filter: blur(2px); }
	button[data-copied] .icon-copy { opacity: 0; transform: scale(0.6); filter: blur(2px); }
	button[data-copied] .icon-done { opacity: 1; transform: none; filter: none; transition: opacity 150ms var(--ease-out), transform 350ms var(--ease-spring-pop), filter 150ms var(--ease-out); }
	:root[data-input='key'] button svg { transition: none; }
	@media (prefers-reduced-motion: reduce) {
		button svg, button[data-copied] svg { transform: none; filter: none; transition: opacity 150ms var(--ease-standard) !important; }
	}
	.copy-status {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	button[data-copy-failed] + .copy-status {
		top: calc(100% + 6px);
		right: 0;
		z-index: 2;
		width: auto;
		height: auto;
		max-width: 100%;
		padding: 8px 12px;
		border-radius: var(--shape-lg);
		background: var(--popover);
		box-shadow: 0 0 0 1px var(--panel-ring), var(--shadow-elevated);
		color: var(--foreground);
		font-size: 12px;
		clip-path: none;
		white-space: normal;
	}
	@media (min-width: 414px) {
		pre { font-size: 12.5px; }
	}
	@media (min-width: 768px) {
		pre { font-size: 13px; }
	}
</style>

<script>
	const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-command]');
	const resetTimers = new WeakMap<HTMLButtonElement, number>();
	const copyAttempts = new WeakMap<HTMLButtonElement, number>();

	const commands = document.querySelectorAll<HTMLElement>('.cmd pre');
	const measure = (pre: HTMLElement) => {
		pre.toggleAttribute('data-overflow', pre.scrollWidth > pre.clientWidth + 1);
		pre.toggleAttribute('data-at-end', pre.scrollLeft + pre.clientWidth >= pre.scrollWidth - 1);
	};
	const resized = new ResizeObserver((entries) => entries.forEach((entry) => measure(entry.target as HTMLElement)));
	for (const pre of commands) {
		resized.observe(pre);
		pre.addEventListener('scroll', () => measure(pre), { passive: true });
	}

	for (const button of copyButtons) {
		button.disabled = false;
		button.addEventListener('click', () => copyCommand(button));
	}

	async function copyCommand(button: HTMLButtonElement) {
		const command = button.closest('.cmd')?.querySelector('code')?.textContent;
		const status = button.closest('.cmd')?.querySelector<HTMLElement>('.copy-status');

		if (command == null || !status) return;

		const attempt = (copyAttempts.get(button) ?? 0) + 1;
		copyAttempts.set(button, attempt);

		const resetTimer = resetTimers.get(button);
		if (resetTimer) window.clearTimeout(resetTimer);

		try {
			if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
			await navigator.clipboard.writeText(command);
			if (copyAttempts.get(button) !== attempt) return;
			button.dataset.copied = '';
			delete button.dataset.copyFailed;
			button.title = 'Copied';
			status.textContent = 'Copied';
		} catch {
			if (copyAttempts.get(button) !== attempt) return;
			delete button.dataset.copied;
			button.dataset.copyFailed = '';
			button.title = 'Copy failed';
			status.textContent = 'Copy failed. Select and copy the command manually.';
		}

		resetTimers.set(button, window.setTimeout(() => {
			delete button.dataset.copied;
			delete button.dataset.copyFailed;
			button.title = 'Copy command';
			status.textContent = '';
		}, 1400));
	}
</script>
