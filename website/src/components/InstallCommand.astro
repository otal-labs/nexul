---
interface Props {
	command: string;
}
const { command } = Astro.props;
---

<div class="cmd">
	<code>{command}</code>
	<button type="button" data-copy-command aria-label="Copy install command">
		<svg class="icon-copy" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
			<rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
			<path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2" />
		</svg>
		<svg class="icon-done" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
			<path d="M3 8.5l3 3 7-7" />
		</svg>
		<span data-copy-label>Copy</span>
	</button>
	<span class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
</div>

<style>
	.cmd {
		display: flex;
		align-items: stretch;
		gap: 8px;
		min-width: 0;
		max-width: 100%;
		padding: 8px 8px 8px 14px;
		border: 1px solid var(--page-border);
		border-radius: 6px;
		background: var(--page-card);
		font-family: var(--page-mono);
		font-size: 13px;
		line-height: 1.5;
	}
	code {
		align-self: center;
		flex: 1;
		min-width: 0;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	button {
		display: grid;
		grid-template-columns: 16px auto;
		place-items: center;
		align-self: center;
		flex: none;
		gap: 6px;
		min-width: 44px;
		min-height: 44px;
		padding: 0 10px;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--page-muted);
		font: inherit;
		cursor: pointer;
	}
	@media (hover: hover) and (pointer: fine) {
		button:hover {
			color: var(--page-fg);
			background: var(--page-popover);
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		button {
			transition: color 150ms, background-color 150ms;
		}
	}
	button:focus-visible {
		outline: 2px solid var(--page-fg);
		outline-offset: 1px;
	}
	.icon-done,
	button[data-copied] .icon-copy {
		display: none;
	}
	button[data-copied] .icon-done {
		display: block;
	}
	.copy-status {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-command]');
	const resetTimers = new WeakMap<HTMLButtonElement, number>();
	const copyAttempts = new WeakMap<HTMLButtonElement, number>();

	for (const button of copyButtons) {
		button.addEventListener('click', () => copyCommand(button));
	}

	async function copyCommand(button: HTMLButtonElement) {
		const command = button.closest('.cmd')?.querySelector('code')?.textContent;
		const label = button.querySelector<HTMLElement>('[data-copy-label]');
		const status = button.closest('.cmd')?.querySelector<HTMLElement>('.copy-status');

		if (command === undefined || !label || !status) return;

		const attempt = (copyAttempts.get(button) ?? 0) + 1;
		copyAttempts.set(button, attempt);

		const resetTimer = resetTimers.get(button);
		if (resetTimer) window.clearTimeout(resetTimer);

		try {
			if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
			await navigator.clipboard.writeText(command);
			if (copyAttempts.get(button) !== attempt) return;
			button.dataset.copied = '';
			label.textContent = 'Copied';
			status.textContent = 'Copied to clipboard';
		} catch {
			if (copyAttempts.get(button) !== attempt) return;
			delete button.dataset.copied;
			label.textContent = 'Copy failed';
			status.textContent = 'Copy failed. Select and copy the command manually.';
		}

		resetTimers.set(button, window.setTimeout(() => {
			delete button.dataset.copied;
			label.textContent = 'Copy';
			status.textContent = '';
		}, 2000));
	}
</script>
