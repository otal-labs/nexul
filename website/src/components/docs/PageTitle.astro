---
const { entry, sidebar } = Astro.locals.starlightRoute;
type SidebarEntry = (typeof sidebar)[number];

const holdsCurrent = (entries: SidebarEntry[]): boolean =>
	entries.some((item) => (item.type === 'link' ? item.isCurrent : holdsCurrent(item.entries)));
const section = sidebar.find((item) => item.type === 'group' && holdsCurrent(item.entries))?.label;
---

{section && <p class="page-eyebrow">{section}</p>}
<h1 id="_top">{entry.data.title}</h1>
