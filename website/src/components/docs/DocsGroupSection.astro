---
import DocCard from './DocCard.astro';
import type { docsGroups } from '../../lib/docs-tree';

interface Props {
	group: ReturnType<typeof docsGroups>[number];
}

const { group } = Astro.props;
const Icon = group.icon;
const id = `group-${group.label.toLowerCase().replaceAll(' ', '-')}`;
---

<section aria-labelledby={id}>
	<h2 id={id} class="docs-group-label mb-4 flex items-center gap-2"><Icon className="size-4" aria-hidden />{group.label}</h2>
	<div class="grid grid-cols-1 gap-2.5 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		{group.pages.map((page) => <DocCard page={page} />)}
	</div>
</section>
