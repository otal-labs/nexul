---
import InstallCommand from './InstallCommand.astro';
interface Props {
	id: string;
}
const { id } = Astro.props;
---

<fieldset class="install-switcher" data-install-switcher>
	<legend>Installation platform</legend>
	<div class="platforms">
		<label><input type="radio" name={`${id}-platform`} value="unix" checked /><span>macOS / Linux</span></label>
		<label><input type="radio" name={`${id}-platform`} value="windows" /><span>Windows</span></label>
	</div>
	<div class="commands">
		<div class="unix-command"><InstallCommand command="curl -fsSL https://nexul.io/install.sh | sh" platform="macOS or Linux" /></div>
		<div class="windows-command"><InstallCommand command="irm https://nexul.io/install.ps1 | iex" platform="Windows" /></div>
	</div>
	<div class="install-meta"><span class="unix-note">Sets up Docker for you</span><span class="windows-note">Needs Docker Desktop</span><a href="/docs/guide/install/">Install guide <span aria-hidden="true">↗</span></a></div>
</fieldset>

<style>
	.install-switcher { border: 0; padding: 0; margin: 0; min-width: 0; }
	legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

	/* The segmented control: a well with a raised thumb that slides to the chosen platform. */
	.platforms {
		position: relative;
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		padding: 2px;
		margin-bottom: 12px;
		border-radius: var(--shape-md);
		background: var(--surface-2);
		box-shadow: 0 0 0 1px var(--border);
	}
	.platforms::before {
		content: '';
		position: absolute;
		inset: 2px auto 2px 2px;
		width: calc(50% - 2px);
		border-radius: calc(var(--shape-md) - 2px);
		background: var(--card);
		box-shadow: 0 0 0 1px var(--panel-ring), var(--shadow-card);
		transition: transform 200ms var(--ease-spring);
	}
	.install-switcher:has(input[value='windows']:checked) .platforms::before { transform: translateX(100%); }
	:root[data-input='key'] .platforms::before { transition: none; }

	label { position: relative; display: grid; min-height: 44px; cursor: pointer; }
	input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; touch-action: manipulation; }
	label > span {
		position: relative;
		display: grid;
		place-items: center;
		padding: 0 14px;
		border-radius: calc(var(--shape-md) - 2px);
		color: var(--muted-foreground);
		font-size: 13px;
		font-weight: 500;
		white-space: nowrap;
		transition: color 150ms var(--ease-standard);
	}
	input:checked + span { color: var(--foreground); }
	input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }

	.windows-command, .windows-note { display: none; }
	.install-switcher:has(input[value='windows']:checked) .windows-command { display: block; }
	.install-switcher:has(input[value='windows']:checked) .windows-note { display: inline; }
	.install-switcher:has(input[value='windows']:checked) :is(.unix-command, .unix-note) { display: none; }

	/* A pointer switch slides the new command in from the side of the picked tab; a key switch swaps at once. */
	@media (prefers-reduced-motion: no-preference) {
		.install-switcher[data-switched]:has(input[value='windows']:checked) .windows-command { animation: command-in 160ms var(--ease-out); }
		.install-switcher[data-switched]:has(input[value='unix']:checked) .unix-command { --from: -6px; animation: command-in 160ms var(--ease-out); }
		:root[data-input='key'] .install-switcher[data-switched] .commands > div { animation: none; }
	}
	@keyframes command-in {
		from { opacity: 0; transform: translateX(var(--from, 6px)); }
	}

	.install-meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--muted-foreground); font-size: 12px; }
	.install-meta a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--foreground); font-weight: 500; }
	@media (hover: hover) and (pointer: fine) {
		label:hover > span { color: var(--foreground); }
		.install-meta a:hover > span { transform: translate(2px, -2px); }
	}
	.install-meta a > span { color: var(--muted-foreground); transition: transform 150ms var(--ease-out); }
</style>

<script>
	const switchers = document.querySelectorAll<HTMLElement>('[data-install-switcher]');
	const platformInputs = document.querySelectorAll<HTMLInputElement>('[data-install-switcher] input');
	for (const input of platformInputs) {
		input.addEventListener('change', () => {
			for (const peer of platformInputs) peer.checked = peer.value === input.value;
			for (const switcher of switchers) switcher.dataset.switched = '';
		});
	}
</script>
