---
interface Props {
	label: string;
	title?: string;
}
const { label, title } = Astro.props;
---

<div class="panel" role="img" aria-label={label}>
	{title && <div class="bar">{title}</div>}
	<div class="body"><slot /></div>
</div>

<style>
	.panel {
		border: 1px solid var(--page-border);
		border-radius: 8px;
		background: var(--page-card);
		font-family: var(--page-mono);
		font-size: 13px;
		line-height: 1.7;
		user-select: none;
		pointer-events: none;
		overflow: hidden;
	}
	.bar {
		padding: 8px 14px;
		border-bottom: 1px solid var(--page-border);
		font-size: 12px;
		color: var(--page-muted);
	}
	.body {
		padding: 14px 16px;
	}
	.body :global(.muted) {
		color: var(--page-muted);
	}
	.body :global(.line) {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.body :global(.group) {
		margin: 0 0 12px;
	}
	.body :global(.group:last-child) {
		margin-bottom: 0;
	}
	.body :global(.group-name) {
		display: block;
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--page-muted);
	}
	.body :global(.tools) {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 14px;
	}
	.body :global(.rows) {
		display: grid;
		gap: 0;
	}
	.body :global(.row) {
		display: grid;
		grid-template-columns: 9ch 1fr;
		gap: 12px;
		padding: 10px 0;
		border-top: 1px solid var(--page-border);
	}
	.body :global(.row:first-child) {
		border-top: 0;
		padding-top: 0;
	}
	.body :global(.row:last-child) {
		padding-bottom: 0;
	}
	.body :global(.row span:last-child) {
		font-family: var(--page-sans);
		font-size: 14px;
		line-height: 1.5;
		color: var(--page-muted);
	}
</style>
