---
// What every page's <head> shares: the three bundled faces, their preloads, and the theme class set before first paint.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import frauncesWoff2 from '../assets/fonts/fraunces-display-latin.woff2?url';

const fraunces = `@font-face{font-family:'Fraunces Variable';font-style:normal;font-display:swap;font-weight:560;src:url(${frauncesWoff2}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
---

<link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={monoWoff2} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={frauncesWoff2} crossorigin />
<style is:global set:html={fraunces}></style>
<meta name="theme-color" content="#060709" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#edeef1" media="(prefers-color-scheme: light)" />
<script is:inline>
	(() => {
		const stored = localStorage.getItem('theme');
		const dark = stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
		document.documentElement.classList.add(dark ? 'dark' : 'light');
	})();
</script>
<script>
	import '../lib/site-chrome';
</script>
