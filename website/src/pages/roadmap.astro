---
import SiteLayout from '../layouts/SiteLayout.astro';

type Status = 'planned' | 'in-progress' | 'shipped';

const label: Record<Status, string> = { planned: 'Planned', 'in-progress': 'In progress', shipped: 'Shipped' };

const items: { name: string; status: Status; summary: string }[] = [
	{ name: 'Phone app', status: 'in-progress', summary: 'Your inbox, chat, board, docs, deploys and logs on Android or iPhone, signed in by scanning a QR code.' },
	{ name: 'Channel webhooks', status: 'shipped', summary: 'Point anything that already posts to a Discord webhook at a Nexul channel instead, by swapping the URL, and manage those bots from the channel\'s settings.' },
	{ name: 'Interview from what you have', status: 'shipped', summary: 'Point a project\'s interview at its standards, docs, or the project it replaces, confirm the drafted answers, and audit the old code against the new rules.' },
	{ name: 'A worktree per thread', status: 'shipped', summary: 'Start each agent thread in its own git worktree, so plays and chats running at the same time never touch the same files.' },
	{ name: 'Emoji in chat', status: 'shipped', summary: 'Pick emoji from a searchable picker in the composer, and react to any message with one.' },
	{ name: 'Editor tables', status: 'shipped', summary: 'Tables in docs, tickets, memories and notes, written by people or agents, kept as tables both ways.' },
	{ name: 'Ticket notes', status: 'in-progress', summary: 'The thread sits beside the ticket, and agents leave notes there, a short message with an editable file, instead of growing the ticket.' },
	{ name: 'T3 Code orchestrator V2', status: 'in-progress', summary: 'Keep working when T3 Code moves to its new orchestrator, with no re-pairing, and see the work an agent hands to other agents as a pill on its reply.' },
	{ name: 'Interview as questions', status: 'in-progress', summary: 'Answer a project\'s interview as question cards, then an agent asks about the gaps and writes the rules every agent turn follows.' },
	{ name: 'Clarify a doc', status: 'planned', summary: 'A client writes what they need, then answers questions about the gaps on the doc page or their phone until nothing is left, and the answers land in the doc.' },
	{ name: 'Projects before code', status: 'planned', summary: 'Start a project with no repository for a client\'s docs, or attach a repository that isn\'t ready to deploy, as plain choices in the wizard, and deploy it later from the project.' },
	{ name: 'Call notes', status: 'planned', summary: 'A voice call becomes notes and a summary in the doc, without anyone typing them.' },
	{ name: 'Semantic search', status: 'planned', summary: 'Find docs and tickets by what they mean, not only by the words they share.' },
	{ name: 'Runner labels', status: 'planned', summary: 'Route a job to the runners that carry the right labels, not just the right machine.' },
	{ name: 'Automatic TLS', status: 'planned', summary: "Let's Encrypt certificates for services served straight from your server." },
	{ name: 'Instance templates', status: 'shipped', summary: 'Set the Interview, mention chips, play instructions and ticket bodies once for the whole instance, and copy any of them to another workspace or project.' },
	{ name: 'Project access', status: 'shipped', summary: 'Give someone, such as a client, only the projects they need, with what they can do set per project. Everything else stays invisible to them.' },
	{ name: 'Private channels', status: 'shipped', summary: 'Channels only the people you add can see and read.' },
	{ name: 'Container logs', status: 'shipped', summary: 'Read what a running service prints, live, from the stack page, the canvas, your phone, or an agent.' },
	{ name: 'Workspace links', status: 'shipped', summary: 'Every page link names its workspace, and each workspace can have its own WEB project and WEB-1 ticket.' },
	{ name: 'Team', status: 'shipped', summary: 'Everyone on the instance in one list, and what each person can reach in every workspace, changed from one place.' },
	{ name: 'Devices', status: 'shipped', summary: 'See every browser and phone signed in to your account, sign any of them out, and connect a phone with a QR code.' },
	{ name: 'Domain-first setup', status: 'shipped', summary: 'First run gives Nexul its https domain behind a setup code, by Cloudflare tunnel, reverse proxy with Let\'s Encrypt, or your own HTTPS, before GitHub.' },
	{ name: 'Native install', status: 'shipped', summary: 'Every part of Nexul runs as a native service on one port, with no containers of its own.' },
	{ name: 'Per-runner credentials', status: 'shipped', summary: 'Each runner enrolls for its own credential, and Remove uninstalls it from its machine.' },
	{ name: 'Automations hosts', status: 'shipped', summary: 'Run automations on named hosts on any machine, and choose which host runs each one.' },
	{ name: 'Guided agent setup', status: 'shipped', summary: 'A wizard that pairs your computer, sets up your coding harness, and installs a starting skill set, with a transcript that reads like a run.' },
	{ name: 'Tickets that carry the testing', status: 'shipped', summary: 'Blocked-by and found-in links, bug flows, templates per ticket type, and a pass or fail step before done.' },
	{ name: 'One-command install', status: 'shipped', summary: 'One command installs Nexul on Linux, macOS, or Windows and opens the setup wizard.' },
	{ name: 'Instance upgrade', status: 'shipped', summary: 'Settings shows the newest release, and one click upgrades every service on the server.' },
	{ name: 'Plays', status: 'shipped', summary: 'One-button agent runs from a ticket or a doc, on your own coding harness, with your permissions.' },
	{ name: 'Memories', status: 'shipped', summary: 'Versioned notes for agents, per project, that agents can write too.' },
	{ name: 'MCP server', status: 'shipped', summary: 'Every capability as a tool, with the same permissions as the person who connected.' },
	{ name: 'Voice', status: 'shipped', summary: 'Voice rooms with full-screen screen share and camera, on a LiveKit server you run. A call ends for you after five minutes alone.' },
	{ name: 'Chat', status: 'shipped', summary: 'Channels, direct messages, and one thread per ticket and per doc, with clickable links and Enter to send.' },
	{ name: 'Automations', status: 'shipped', summary: 'Event-driven TypeScript, scoped to a workspace, each automation acting through its own scoped token and switched on or off per workspace.' },
	{ name: 'Topology', status: 'shipped', summary: 'A canvas of every service, network, gateway, and hostname, with live status.' },
	{ name: 'DNS and tunnels', status: 'shipped', summary: 'Cloudflare records and tunnels, so a service can go live with no open ports.' },
	{ name: 'Stacks and deploys', status: 'shipped', summary: 'A runner deploys your compose file, with history, preview branches, and one-click rollback.' },
	{ name: 'Runners', status: 'shipped', summary: 'A small binary on each server that connects out, so Nexul never holds an SSH key.' },
	{ name: 'Live collaboration', status: 'shipped', summary: 'Several people edit one doc at once, with live cursors and merged edits.' },
	{ name: 'Docs and tickets', status: 'shipped', summary: 'Versioned docs in folders per project, with watchers, pinned docs and a resizable list, a board per project, and tickets linked to branches and pull requests.' },
	{ name: 'Desktop app', status: 'shipped', summary: 'A desktop shell that keeps a list of your instances and opens the one you pick.' },
];
---

<SiteLayout title="Roadmap · Nexul" description="What has shipped in Nexul, what is being built now, and what comes next.">
	<section class="page-hero wrap" aria-labelledby="roadmap-title">
		<p class="eyebrow">Roadmap</p>
		<h1 id="roadmap-title">What's shipped.<br />What's next<span class="muted">.</span></h1>
		<p class="page-lede">Directional, not dated. For what changed in each release, see the <a href="/changelog/">changelog</a>.</p>
	</section>
	<section class="rail-section wrap" aria-label="Roadmap items">
		<ol class="rail">
			{items.map((item) => (
				<li class="rail-item">
					<span class="rail-dot" data-status={item.status} aria-hidden="true"></span>
					<h2 class="rail-title" data-status={item.status}>{item.name}<span class="rail-status">{label[item.status]}</span></h2>
					<p>{item.summary}</p>
				</li>
			))}
		</ol>
	</section>
</SiteLayout>
