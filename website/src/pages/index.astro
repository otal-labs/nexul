---
import SiteLayout from '../layouts/SiteLayout.astro';
import InstallSwitcher from '../components/InstallSwitcher.astro';
import ProductShot from '../components/ProductShot.astro';
import { NexulIcon } from '../components/NexulIcon';
import '../styles/home.css';

const stepShot = { widths: [400, 640, 960, 1280], sizes: '(min-width: 1264px) 560px, (min-width: 768px) calc(50vw - 56px), calc(100vw - 40px)' };
const steps = [
	{
		number: '01',
		title: 'Write the plan',
		body: 'Write the passkey sign-in spec together, in real time. Clarify via AI asks about what it leaves open, round by round.',
		href: '/docs/guide/docs-tickets-and-board/#docs',
		link: 'Docs',
		shot: 'doc',
		alt: 'The Passkey sign-in spec open in Docs: its Problem and Flow sections.',
	},
	{
		number: '02',
		title: 'Cut it into tickets',
		body: 'Ten tickets come from the spec. Each keeps it as the source, links its branch and pull request, and has a thread where agents post their runs.',
		href: '/docs/guide/docs-tickets-and-board/#tickets',
		link: 'Tickets and the board',
		shot: 'ticket',
		alt: 'Ticket ACC-3, Sign in with a passkey on the login page: what needs doing, its acceptance criteria and the ticket’s properties.',
	},
	{
		number: '03',
		title: 'Ship to your servers',
		body: 'A runner on your machine builds accounts-api 1.4.0 and deploys it. Each step and its log stay on the deploy page.',
		href: '/docs/guide/stacks-and-deploys/',
		link: 'Stacks and deploys',
		shot: 'deploy',
		alt: 'A finished deploy of accounts-api 1.4.0: four completed steps beside the clone, build and deploy log.',
	},
	{
		number: '04',
		title: 'Hear what happened',
		body: 'The deploy bot posts the rollout as a card, with its ticket and pull request, in the channel your team already reads.',
		href: '/docs/guide/bots/',
		link: 'Bots',
		shot: 'chat',
		alt: 'The deploy bot’s card in #engineering, accounts-api 1.4.0 deployed and healthy, then the team’s replies about the rollout.',
	},
];
const capabilities = [
	['Docs and tickets', 'The plan and the work, linked.', '/docs/guide/docs-tickets-and-board/'],
	['Chat and voice', 'Channels and calls beside the work.', '/docs/guide/chat-and-voice/'],
	['Automations', 'Your events, in TypeScript.', '/docs/guide/automations/'],
	['Topology and DNS', 'Where every service runs and how it is reached.', '/docs/guide/topology-and-dns/'],
	['Runners and logs', 'Build, deploy, and read what happened.', '/docs/guide/runners/'],
	['API and access', 'Scoped tokens and one permission table.', '/docs/guide/api-and-tokens/'],
];
---

<SiteLayout
	title="Nexul · From docs to deploy, on your servers"
	description="Docs, tickets, chat and deploys in one self-hosted workspace. One MCP server lets your coding agents work in it with your permissions."
	ogDescription="Docs, tickets, chat and deploys in one self-hosted workspace."
>
	<div class="home">
		<section class="home-hero wrap" aria-labelledby="hero-title">
			<p class="eyebrow">Self-hosted workspace for software teams</p>
			<h1 id="hero-title" class="type-display hero-title">From the first doc to the next deploy.</h1>
			<div class="hero-lead">
				<p class="hero-lede">Docs, tickets, chat and deploys share one workspace on your own server. Your coding agents work in it through one MCP server.</p>
				<div class="hero-install"><InstallSwitcher id="hero" /></div>
			</div>
			<figure class="hero-shot">
				<ProductShot
					name="board"
					widths={[960, 1440, 1920, 2336]}
					sizes="(min-width: 1264px) 1136px, calc(100vw - 72px)"
					narrow={{ name: 'board-narrow', widths: [480, 720, 960], sizes: 'calc(100vw - 56px)' }}
					alt="The Accounts board in the Northwind example workspace: passkey sign-in tickets in Backlog, In progress, In review and Testing, split into Sign-in and Security lanes, the stage bar above them."
					priority
				/>
				<script is:inline>
					(() => {
						const root = document.documentElement;
						const sync = () => {
							const scheme = root.classList.contains('light') ? 'light' : root.classList.contains('dark') ? 'dark' : '';
							if (!scheme) return;
							for (const source of document.querySelectorAll('picture[data-themed] source')) {
								source.media = source.dataset.scheme === scheme ? source.dataset.base : 'not all';
							}
						};
						sync();
						document.addEventListener('DOMContentLoaded', sync);
						new MutationObserver(sync).observe(root, { attributeFilter: ['class'] });
						// The shot arrives once it has decoded, so it never paints half-drawn, and only on the first visit of a session.
						const figure = document.currentScript.closest('figure');
						if (sessionStorage.getItem('home-arrived')) return;
						sessionStorage.setItem('home-arrived', '1');
						figure.dataset.arrive = 'wait';
						const go = () => (figure.dataset.arrive = 'go');
						figure.querySelector('img').decode().then(go, go);
					})();
				</script>
			</figure>
		</section>

		<section class="home-section wrap" id="product" aria-labelledby="product-title">
			<div class="section-intro">
				<p class="eyebrow">One project, every stage</p>
				<h2 id="product-title">The plan, the work and what’s running, linked.</h2>
				<p class="section-description">One feature, passkey sign-in, from its spec to the rollout. A ticket keeps the doc it came from, a deploy names its ticket and pull request, and nothing gets copied between tools.</p>
			</div>
			<ol class="steps">
				{steps.map((step) => (
					<li class="step">
						<div class="step-shot"><ProductShot name={step.shot} alt={step.alt} {...stepShot} /></div>
						<div class="step-copy">
							<span class="step-index">{step.number}</span>
							<h3>{step.title}</h3>
							<p>{step.body}</p>
							<a class="detail-link" href={step.href}>{step.link}<span aria-hidden="true">→</span></a>
						</div>
					</li>
				))}
			</ol>
		</section>

		<section class="home-band" id="developers" aria-labelledby="developer-title">
			<div class="wrap band-grid">
				<div class="band-copy">
					<p class="eyebrow">For your coding agents</p>
					<h2 id="developer-title">Agents work in it as you.</h2>
					<p>Connect any MCP client to your instance. The agent reads docs, files tickets, posts in chat and deploys stacks as you, with your permissions and nothing more.</p>
					<a class="text-link" href="/docs/guide/mcp-server/">Connect an agent <span aria-hidden="true">↗</span></a>
				</div>
				<div class="tool-console" role="group" aria-label="Example of an agent using the Nexul MCP server">
					<div class="console-header"><span class="connection-dot"></span><span>nexul / mcp</span><span class="console-label">Example</span></div>
					<div class="console-prompt"><span aria-hidden="true">›</span><p>What is blocking the code rate limits?</p></div>
					<div class="tool-call"><span class="tool-symbol" aria-hidden="true">↳</span><div><span class="tool-name">ticket_list</span><code>"rate limit"</code></div><span class="tool-check" aria-hidden="true">✓</span></div>
					<div class="tool-result result-tickets"><span>ACC-5</span><span>Rate limit code requests and wrong codes</span></div>
					<div class="tool-call"><span class="tool-symbol" aria-hidden="true">↳</span><div><span class="tool-name">ticket_get</span><code>"ACC-5"</code></div><span class="tool-check" aria-hidden="true">✓</span></div>
					<div class="tool-result result-tickets"><span>Blocked by</span><span>ACC-4 · Email a one-time code when no passkey is available</span><span>Status</span><span>In progress</span></div>
					<div class="console-footer"><NexulIcon /><span>One workspace. One set of permissions.</span></div>
				</div>
			</div>
		</section>

		<section class="home-section wrap" aria-labelledby="hosting-title">
			<div class="band-grid">
				<div class="band-copy">
					<p class="eyebrow">Your servers</p>
					<h2 id="hosting-title">Keep your work. Own where it runs.</h2>
					<p>Nexul runs as native services on one port of your server. A runner on each machine you deploy to connects out to it, so the instance never holds an SSH key.</p>
					<a class="text-link" href="/docs/guide/install/">Read the install guide <span aria-hidden="true">↗</span></a>
				</div>
				<div class="infrastructure" role="img" aria-label="A Nexul instance with runners on two of your machines. The runners connect out to the instance; it holds no SSH keys.">
					<div class="instance-node"><span class="instance-icon"><NexulIcon /></span><span><strong>Your Nexul instance</strong><small>Docs · Tickets · Chat · MCP</small></span></div>
					<div class="network-lines"></div>
					<div class="server-nodes">
						<div><span class="node-label">prod-eu-west-01</span><strong>Any VPS</strong></div>
						<div><span class="node-label">build-01</span><strong>Your hardware</strong></div>
					</div>
					<p class="infrastructure-note">Runners connect out. No SSH keys to hand over.</p>
				</div>
			</div>
			<ul class="capabilities">
				{capabilities.map(([title, description, href]) => (
					<li><a class="capability" href={href}><span><strong>{title}</strong><span>{description}</span></span><span class="capability-arrow" aria-hidden="true">↗</span></a></li>
				))}
			</ul>
		</section>

		<section class="home-band home-install" id="install" aria-labelledby="install-title">
			<div class="wrap band-grid">
				<div class="band-copy">
					<p class="eyebrow">Install</p>
					<h2 id="install-title">One command on your server.</h2>
					<p>The installer starts the server and its runner, then prints the setup page and a code to open it with.</p>
				</div>
				<div class="installation">
					<InstallSwitcher id="closing" />
					<p class="beta-note"><span class="beta-dot"></span><span>In beta: expect rough edges and breaking changes.</span></p>
				</div>
			</div>
		</section>
	</div>
</SiteLayout>
