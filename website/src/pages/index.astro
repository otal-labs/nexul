---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/landing.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import InstallSwitcher from '../components/InstallSwitcher.astro';
import WorkflowPreview from '../components/WorkflowPreview.astro';
import Icon from '../components/Icon.astro';

const github = 'https://github.com/otal-labs/nexul';
const steps = [
	{ number: '01', title: 'Start with a document.', body: 'Write the plan together. Keep decisions, revisions, and the discussion in one place.', href: '/docs/guide/docs-tickets-and-board/#docs', link: 'Docs & collaboration' },
	{ number: '02', title: 'Turn the plan into work.', body: 'Scope tickets, move them across the board, and link the branches and pull requests.', href: '/docs/guide/docs-tickets-and-board/#tickets', link: 'Tickets & boards' },
	{ number: '03', title: 'Ship to your servers.', body: 'Let a runner build and deploy your stack. Inspect the logs. Roll back when you need to.', href: '/docs/guide/stacks-and-deploys/', link: 'Stacks & deployments' },
	{ number: '04', title: 'Keep the context.', body: 'Search the docs and tickets. Follow the conversation. Start the next piece of work informed.', href: '/docs/guide/mcp-server/', link: 'Explore the workflow' },
];
const capabilities = [
	['Docs & tickets', 'The plan and the work, linked.', '/docs/guide/docs-tickets-and-board/'],
	['Chat & collaboration', 'Conversations alongside the work.', '/docs/guide/docs-tickets-and-board/'],
	['Automations', 'Your events. Your TypeScript.', '/docs/guide/automations/'],
	['Topology & DNS', 'See where every service runs.', '/docs/guide/topology-and-dns/'],
	['Runners & logs', 'Build, deploy, and see what happened.', '/docs/guide/runners/'],
	['API & access', 'Scoped tokens and shared permissions.', '/docs/guide/api-and-tokens/'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Nexul · From docs to deploy, on your servers</title>
		<meta name="description" content="Bring docs, tickets, chat, and deployments into one self-hosted workspace. One MCP server connects your coding tools to the whole workflow. Your work, on your servers." />
		<meta property="og:title" content="Nexul · From docs to deploy, on your servers" />
		<meta property="og:description" content="Docs, tickets, chat, and deployments in one self-hosted workspace. Keep the whole loop connected." />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="#050505" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ececec" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={monoWoff2} crossorigin />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="wrap nav-inner">
				<a class="wordmark" href="/" aria-label="Nexul home"><Icon /> Nexul</a>
				<nav aria-label="Main navigation">
					<a class="nav-detail" href="#product">Product</a>
					<a class="nav-detail" href="#developers">Developers</a>
					<a href="/docs/">Docs</a>
					<a class="nav-detail" href={github}>GitHub <span aria-hidden="true">↗</span></a>
					<a class="button button-small" href="#install">Get started <span aria-hidden="true">↗</span></a>
				</nav>
			</div>
		</header>

		<main id="main">
			<section class="hero wrap" aria-labelledby="hero-title">
				<p class="eyebrow"><span class="brand-mark"></span> The self-hosted software workspace</p>
				<div class="hero-heading">
					<h1 id="hero-title">From the first doc<br />to the next deploy<span class="muted">.</span></h1>
					<div class="hero-install"><InstallSwitcher id="hero" /></div>
				</div>
				<WorkflowPreview />
				<div class="hero-footnote"><span>One project. The whole trail.</span><span>Open core <span class="separator">/</span> Self-hosted <span class="separator">/</span> In beta</span></div>
			</section>

			<section class="product-section wrap" id="product" aria-labelledby="product-title">
				<div class="section-intro">
					<div><p class="eyebrow">The work stays connected</p><h2 id="product-title">Less switching tools.<br />More moving forward.</h2></div>
					<p class="section-description">The idea, the implementation, and the running software belong in the same story. Nexul keeps the links between them.</p>
				</div>
				<div class="workflow-steps">
					{steps.map((step) => <article class="workflow-step"><span class="step-index">{step.number}<span aria-hidden="true">↗</span></span><h3>{step.title}</h3><p>{step.body}</p><a class="detail-link" href={step.href}>{step.link}<span aria-hidden="true">→</span></a></article>)}
				</div>
			</section>

			<section class="developer-section" id="developers" aria-labelledby="developer-title">
				<div class="wrap developer-grid">
					<div class="developer-copy"><p class="eyebrow">Built for the way you work now</p><h2 id="developer-title">Your tools get<br />the whole picture.</h2><p>Connect your coding tools to one MCP server. Search a doc, create a ticket, inspect a stack, or start a deploy with the same permissions you have in the app.</p><p class="muted">Your context stays in your workspace. Your tools can act on it.</p><a class="text-link" href="/docs/guide/mcp-server/">Explore the MCP server <span aria-hidden="true">↗</span></a></div>
					<div class="tool-console" role="group" aria-label="Example of the tools available through the Nexul MCP server">
						<div class="console-header"><span class="connection-dot"></span><span>nexul / mcp</span><span class="console-label">EXAMPLE</span></div>
						<div class="console-prompt"><span aria-hidden="true">›</span><p>Find the release spec and the tickets that came from it.</p></div>
						<div class="tool-call"><span class="tool-symbol" aria-hidden="true">↳</span><div><span class="tool-name">doc_list</span><code>"release spec"</code></div><span class="tool-check" aria-hidden="true">✓</span></div>
						<div class="tool-result"><span class="file-outline" aria-hidden="true"></span><div><strong>A better way to ship a release</strong><span>Document · version 4</span></div></div>
						<div class="tool-call"><span class="tool-symbol" aria-hidden="true">↳</span><div><span class="tool-name">ticket_list</span><code>"release"</code></div><span class="tool-check" aria-hidden="true">✓</span></div>
						<div class="tool-result result-tickets"><span>NX-42</span><span>Add the release endpoint</span><span>NX-43</span><span>Write the release notes</span><span>NX-44</span><span>Verify the rollback</span></div>
						<div class="console-footer"><Icon /><span>One workspace. One set of permissions.</span></div>
					</div>
				</div>
			</section>

			<section class="hosting-section wrap" aria-labelledby="hosting-title">
				<div class="hosting-grid">
					<div class="hosting-copy"><p class="eyebrow">Ordinary servers. Your servers.</p><h2 id="hosting-title">Keep your work.<br />Own where it runs.</h2><p>A Docker Compose stack for your workspace. A lightweight runner on each machine you deploy to. Start on one server and connect more when you need them.</p><a class="text-link" href="/docs/guide/install/">Read the self-hosting guide <span aria-hidden="true">↗</span></a></div>
					<div class="infrastructure" role="img" aria-label="A Nexul instance connects to runners on your own servers. Runners connect outbound; the instance holds no SSH keys.">
						<div class="instance-node"><span class="instance-icon"><Icon /></span><span><strong>Your Nexul instance</strong><small>Docs · Tickets · Chat · MCP</small></span><span class="node-caption">YOU OWN THIS</span></div>
						<div class="network-lines"></div>
						<div class="server-nodes"><div><span class="technical muted">RUNNER / 01</span><strong>Any VPS</strong><span class="node-services"><i></i><i></i><i></i></span></div><div><span class="technical muted">RUNNER / 02</span><strong>Your hardware</strong><span class="node-services"><i></i><i></i><i></i></span></div></div>
						<p class="infrastructure-note">Outbound connections. No SSH keys to hand over.</p>
					</div>
				</div>
				<div class="capability-list">{capabilities.map(([title, description, href]) => <a class="capability" href={href}><span><strong>{title}</strong><span>{description}</span></span><span class="capability-arrow" aria-hidden="true">↗</span></a>)}</div>
			</section>

			<section class="install-section" id="install" aria-labelledby="install-title">
				<div class="wrap install-grid">
					<div><p class="eyebrow">Make it your workspace</p><h2 id="install-title">Your next project<br />starts here.</h2><p>Run the installer and open the setup wizard.</p></div>
					<div class="installation"><InstallSwitcher id="closing" /><p class="beta-note"><span class="beta-dot"></span><span>Currently in beta. Expect rough edges and breaking changes.</span></p></div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap"><div class="footer-top"><a class="wordmark" href="/" aria-label="Nexul home"><Icon /> Nexul</a><p>One loop from docs to deploy.</p><nav aria-label="Footer navigation"><a href="/docs/">Documentation</a><a href={github}>GitHub <span aria-hidden="true">↗</span></a><a href="/docs/contributing/licensing/">License</a></nav></div><div class="footer-bottom"><span>Your work. Your servers.</span><p>AGPL-3.0 core. Commercial features live in <code>ee/</code>. <a href="/docs/contributing/licensing/">How licensing works <span aria-hidden="true">↗</span></a></p></div></div>
		</footer>
	</body>
</html>
