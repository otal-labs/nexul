{
  "name": "nexul-desktop",
  "version": "0.1.0",
  "description": "Nexul desktop client: a thin Electron shell around the server's web app, bootstrapped by connection tokens.",
  "homepage": "https://nexul.io",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "bun run build:electron && bun run build:launcher",
    "build:electron": "tsc -p tsconfig.electron.json && vite build --config vite.preload.config.ts",
    "build:launcher": "vite build",
    "start": "bun run build && electron .",
    "dist": "bun run build && electron-builder",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.launcher.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "io.nexul.desktop",
    "productName": "Nexul",
    "files": ["dist-electron/**", "dist/**", "package.json"],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "maintainer": "Nexul"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    }
  }
}
