{
  "name": "@otal-labs/nexul-sdk",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "nexul": "./bin/cli.ts"
  },
  "exports": {
    "./automation": "./src/define-automation.ts",
    "./client": "./src/client.ts",
    "./api-client": "./src/api-client.ts",
    "./events": "./src/events.generated.ts",
    "./context": "./src/context.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate:events": "bun run tools/generate-events.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  },
  "description": "Write Nexul automations in TypeScript: typed events, a typed API client, and the nexul CLI to test and push them.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otal-labs/nexul.git",
    "directory": "sdk"
  },
  "homepage": "https://nexul.io/docs/guide/automations/",
  "files": [
    "bin",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
